// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id        Int           @id @default(autoincrement())
  userName  String        @unique
  fullname  String?       @default("name")
  password  String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  products  ProductInfo[]
}

model ProductInfo {
  id                 Int            @id @default(autoincrement())
  productName        String
  productType        String
  productGenderUse   String
  productPrice       Decimal        // Best practice: store currency as Decimal or Int (cents)
  productDescription String?
  productQuantity    Int
  productValue       Int?
  
  adminUsername      String
  admin              Admin          @relation(fields: [adminUsername], references: [userName], onDelete: Cascade)
  
  // Relations
  media              ProductMedia[] // Handles all images and videos dynamically
  orderItems         OrderedItems[]

  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

enum MediaType {
  IMAGE
  VIDEO
}

model ProductMedia {
  id        Int         @id @default(autoincrement())
  url       String      // Cloudinary secure_url returned after upload
  publicId  String      @unique // Cloudinary public_id (crucial for deleting/updating media later)
  type      MediaType   @default(IMAGE)
  isMain    Boolean     @default(false) // True for the primary product thumbnail
  
  productId Int
  product   ProductInfo @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  createdAt DateTime    @default(now())
}

model Customer {
  customerId  Int      @id @default(autoincrement())
  fullname    String
  email       String   @unique
  phoneNumber String   @unique
  
  orders      Orders[] // A customer can have many orders
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Orders {
  orderId     Int            @id @default(autoincrement())
  
  customerId  Int
  customer    Customer       @relation(fields: [customerId], references: [customerId])
  
  items       OrderedItems[] // An order can have many items
  
  totalAmount Decimal        @default(0.00)
  status      String         @default("PENDING") // PENDING, PROCESSING, COMPLETED, CANCELLED
  
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model OrderedItems {
  orderItemId Int         @id @default(autoincrement())
  
  orderId     Int
  order       Orders      @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  
  productId   Int
  product     ProductInfo @relation(fields: [productId], references: [id])
  
  quantity    Int
  price       Decimal     // Locking in the price at the time of purchase
}